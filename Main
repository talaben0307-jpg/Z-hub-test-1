local camera = Workspace.CurrentCamera

local executionState = {
    Noclip = false,
    Bypass = false,
    SweepAll = false,
    ViewRandom = false
}

local configuration = {
    SweepTime = 0.01
}

local resetMetricsCount = 0

local function dispatchNotification(header, content)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = header,
            Text = content,
            Duration = 3
        })
    end)
end

