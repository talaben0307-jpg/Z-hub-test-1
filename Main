-- XỬ LÝ NÚT BẤM
TabMainBtn.MouseButton1Click:Connect(function()
    PageMain.Visible = true; PageSetting.Visible = false
    TabMainBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60); TabMainBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabSettingBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30); TabSettingBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
end)

TabSettingBtn.MouseButton1Click:Connect(function()
    PageMain.Visible = false; PageSetting.Visible = true
    TabSettingBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60); TabSettingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabMainBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30); TabMainBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
end)

ToggleNoclipBtn.MouseButton1Click:Connect(function()
    state.Noclip = not state.Noclip
    ToggleNoclipBtn.Text = state.Noclip and "👻 Noclip: ON" or "👻 Noclip: OFF"
    ToggleNoclipBtn.BackgroundColor3 = state.Noclip and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
end)

ToggleBypassBtn.MouseButton1Click:Connect(function()
    state.Bypass = not state.Bypass
    ToggleBypassBtn.Text = state.Bypass and "🛡️ Bypass AC (Smart): ON" or "🛡️ Bypass AC (Smart): OFF"
    ToggleBypassBtn.BackgroundColor3 = state.Bypass and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
    if state.Bypass then resetCount = 0 end
end)

ToggleSweepBtn.MouseButton1Click:Connect(function()
    state.SweepAll = not state.SweepAll
    ToggleSweepBtn.Text = state.SweepAll and "⚡ Gojo Sweep All: ON" or "⚡ Gojo Sweep All: OFF"
    ToggleSweepBtn.BackgroundColor3 = state.SweepAll and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
end)

ApplyBgBtn.MouseButton1Click:Connect(function()
    local url = UrlInput.Text
    if url and url ~= "" then
        ApplyBgBtn.Text = "Đang tải..."
        pcall(function()
            local imgData = game:HttpGet(url)
            writefile("ZHub_CustomBigBg.png", imgData)
            BgImage.Image = getcustomasset("ZHub_CustomBigBg.png")
        end)
        ApplyBgBtn.Text = "Đổi Ảnh Nền"
    end
end)

-- LOGIC CHỨC NĂNG
RunService.Stepped:Connect(function()
    if state.Noclip and localPlayer.Character then
        for _, part in ipairs(localPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)

-- LOGIC SMART BYPASS (Tự động nhận biết và tắt nút khi xong)
task.spawn(function()
    while true do
        task.wait(0.5)
        if state.Bypass then
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            
            if hrp and humanoid and humanoid.Health > 0 then
                local target = nil
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        target = p.Character.HumanoidRootPart
                        break
                    end
                end
                
                if target then
                    -- Lưu tọa độ gốc để so sánh
                    local startPos = hrp.Position
                    hrp.CFrame = target.CFrame * CFrame.new(0, 0, 2.5)
                    
                    local teleportedBack = false
                    local timer = 0
                    
                    -- Chờ 3 giây để xem AC có phản ứng không
                    while timer < 3 do
                        task.wait(0.1)
                        timer = timer + 0.1
                        if not state.Bypass or not humanoid or humanoid.Health <= 0 then break end
                        -- Kiểm tra Magnitude: Nếu khoảng cách so với lúc đầu quá ngắn -> Bị giật về
                        if (hrp.Position - startPos).Magnitude < 10 then
                            teleportedBack = true
                            break
                        end
                    end
                    
                    if state.Bypass and humanoid and humanoid.Health > 0 then
                        if teleportedBack then
                            print("[Bypass] Bị giật về, tiến hành ép Reset...")
                            local resetRemote = ReplicatedStorage:FindFirstChild("Knit") 
                                and ReplicatedStorage.Knit:FindFirstChild("Services") 
                                and ReplicatedStorage.Knit.Services:FindFirstChild("JoinService")
                                and ReplicatedStorage.Knit.Services.JoinService:FindFirstChild("RE")
                                and ReplicatedStorage.Knit.Services.JoinService.RE:FindFirstChild("Reset")

                            pcall(function()
                                -- Thử bắn lệnh Knit Reset
                                if resetRemote then resetRemote:FireServer() end
                                -- Kết hợp lao thẳng xuống vực cho chắc chắn
                                if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Dead) end
                                if hrp then hrp.CFrame = CFrame.new(0, -99999, 0) end
                            end)
                            
                            resetCount = resetCount + 1
                            if localPlayer.CharacterAdded then
                                localPlayer.CharacterAdded:Wait()
                            end
                            task.wait(1.5)
                        else
                            -- Nếu qua được bước đo Magnitude mà không bị giật -> Bypass Thành Công!
                            state.Bypass = false
                            ToggleBypassBtn.Text = "🛡️ Bypass AC (Smart): OFF"
                            ToggleBypassBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                            print("[Bypass] Thành công sau " .. tostring(resetCount) .. " lần reset!")
                        end
                    end
                end
            end
        end
    end
end)

-- LOGIC GOJO SWEEP ALL
task.spawn(function()
    while true do
        task.wait(CONFIG.SweepTime)
        if state.SweepAll then
            local myChar = localPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local humanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
            
            if myHRP and humanoid and humanoid.Health > 0 then
                local targets = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = p.Character.HumanoidRootPart
                        if (hrp.Position - myHRP.Position).Magnitude <= 500 then
                            table.insert(targets, hrp)
                        end
                    end
                end
                
                for _, targetHRP in ipairs(targets) do
                    if not state.SweepAll or not humanoid or humanoid.Health <= 0 then break end
                    if myHRP and targetHRP and targetHRP.Parent then
                        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, -3, 2.5)
                        myHRP.Velocity = Vector3.new(0, 0, 0)
                    end
                    task.wait(CONFIG.SweepTime)
                end
            end
        end
    end
end)
