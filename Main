    pageMain.Visible = false
    pageSetting.Visible = true
    tabSettingBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    tabSettingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tabMainBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    tabMainBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
end)

toggleNoclipBtn.MouseButton1Click:Connect(function()
    executionState.Noclip = not executionState.Noclip
    toggleNoclipBtn.Text = executionState.Noclip and "👻 Noclip: ON" or "👻 Noclip: OFF"
    toggleNoclipBtn.BackgroundColor3 = executionState.Noclip and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
end)

toggleBypassBtn.MouseButton1Click:Connect(function()
    executionState.Bypass = not executionState.Bypass
    if executionState.Bypass then
        resetMetricsCount = 0
        dispatchNotification("Z Hub", "Start bypass")
        toggleBypassBtn.Text = "🛡️ Bypass AC (Auto): ON"
        toggleBypassBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
    else
        toggleBypassBtn.Text = "🛡️ Bypass AC (Auto): OFF"
        toggleBypassBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    end
end)

toggleSweepBtn.MouseButton1Click:Connect(function()
    executionState.SweepAll = not executionState.SweepAll
    toggleSweepBtn.Text = executionState.SweepAll and "⚡ Sweep All: ON" or "⚡ Sweep All: OFF"
    toggleSweepBtn.BackgroundColor3 = executionState.SweepAll and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
end)

toggleViewBtn.MouseButton1Click:Connect(function()
    executionState.ViewRandom = not executionState.ViewRandom
    toggleViewBtn.Text = executionState.ViewRandom and "👁️ View Random: ON" or "👁️ View Random: OFF"
    toggleViewBtn.BackgroundColor3 = executionState.ViewRandom and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
    
    if not executionState.ViewRandom then
        local myCharacter = localPlayer.Character
        local myHumanoid = myCharacter and myCharacter:FindFirstChildOfClass("Humanoid")
        if myHumanoid then camera.CameraSubject = myHumanoid end
    end
end)

timeInputBox.FocusLost:Connect(function()
    local numericValue = tonumber(timeInputBox.Text)
    if numericValue then
        configuration.SweepTime = numericValue
        dispatchNotification("Z Hub", "Đã cập nhật Sweep Time: " .. tostring(numericValue))
    end
end)

applyBgButton.MouseButton1Click:Connect(function()
    local targetUrl = urlInputBox.Text
    if targetUrl and targetUrl ~= "" then
        applyBgButton.Text = "Đang tải..."
        pcall(function()
            local fetchedData = game:HttpGet(targetUrl)
            writefile("ZHub_CustomBg.png", fetchedData)
            backgroundImage.Image = getcustomasset("ZHub_CustomBg.png")
            dispatchNotification("Z Hub", "Đổi ảnh nền thành công!")
        end)
        applyBgButton.Text = "Đổi Ảnh Nền"
    end
end)

-- // ====================================================================
-- // Module: Core Mechanics & Automated Tasks
-- // ====================================================================

RunService.Stepped:Connect(function()
    if executionState.Noclip and localPlayer.Character then
        for _, descendant in ipairs(localPlayer.Character:GetDescendants()) do
            if descendant:IsA("BasePart") then descendant.CanCollide = false end
        end
    end
end)

local function resolveTargetEntity(maxDistance)
    maxDistance = maxDistance or 500
    local accumulatedTargets = {}
    
    local myChar = localPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            local hrpPart = player.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrpPart then
                if (hrpPart.Position - myHRP.Position).Magnitude <= maxDistance then
                    table.insert(accumulatedTargets, hum)
                end
            end
        end
    end
    
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("Model") and string.lower(object.Name) == "dummy" then
            local hum = object:FindFirstChildOfClass("Humanoid")
            local hrpPart = object:FindFirstChild("HumanoidRootPart") or object:FindFirstChild("Torso")
            if hum and hum.Health > 0 and hrpPart then
                if (hrpPart.Position - myHRP.Position).Magnitude <= maxDistance then
                    table.insert(accumulatedTargets, hum)
                end
            end
        end
    end
    
    if #accumulatedTargets > 0 then
        return accumulatedTargets[math.random(1, #accumulatedTargets)]
    end
    return nil
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if executionState.Bypass then
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            
            if hrp and humanoid and humanoid.Health > 0 then
                local targetHumanoid = resolveTargetEntity(500)
                local targetHRP = targetHumanoid and targetHumanoid.Parent and (targetHumanoid.Parent:FindFirstChild("HumanoidRootPart") or targetHumanoid.Parent:FindFirstChild("Torso"))
                
                if targetHRP then
                    local initialPosition = hrp.Position
                    hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 2.5)
                    
                    local isRubberbanded = false
                    local timerDuration = 0
                    
                    while timerDuration < 3 do
                        task.wait(0.1)
                        timerDuration = timerDuration + 0.1
                        if not executionState.Bypass or not humanoid or humanoid.Health <= 0 then break end
                        if (hrp.Position - initialPosition).Magnitude < 10 then
                            isRubberbanded = true
                            break
                        end
                    end
                    
                    if executionState.Bypass and humanoid and humanoid.Health > 0 then
                        if isRubberbanded then
                            local resetRemoteEvent = ReplicatedStorage:FindFirstChild("Knit")
                                and ReplicatedStorage.Knit:FindFirstChild("Knit")
                                and ReplicatedStorage.Knit.Knit:FindFirstChild("Services")
                                and ReplicatedStorage.Knit.Knit.Services:FindFirstChild("JoinService")
                                and ReplicatedStorage.Knit.Knit.Services.JoinService:FindFirstChild("RE")
                                and ReplicatedStorage.Knit.Knit.Services.JoinService.RE:FindFirstChild("Reset")
                            
                            while executionState.Bypass and humanoid and humanoid.Health > 0 do
                                if resetRemoteEvent then
                                    resetRemoteEvent:FireServer()
                                    resetMetricsCount = resetMetricsCount + 1
                                end
                                task.wait(3)
                            end
                        else
                            dispatchNotification("Z Hub", "Bypass Success (Resets: " .. tostring(resetMetricsCount) .. ")")
                            task.wait(2)
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(configuration.SweepTime)
        if executionState.SweepAll then
            local myChar = localPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local humanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
            
            if myHRP and humanoid and humanoid.Health > 0 then
                local targetCollection = {}
                
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local hrpPart = player.Character.HumanoidRootPart
                        if (hrpPart.Position - myHRP.Position).Magnitude <= 500 then
                            table.insert(targetCollection, hrpPart)
                        end
                    end
                end
                
                for _, object in ipairs(Workspace:GetDescendants()) do
                    if object:IsA("Model") and string.lower(object.Name) == "dummy" then
                        local hrpPart = object:FindFirstChild("HumanoidRootPart") or object:FindFirstChild("Torso")
                        if hrpPart and (hrpPart.Position - myHRP.Position).Magnitude <= 500 then
                            table.insert(targetCollection, hrpPart)
                        end
                    end
                end
                
                for _, targetHRP in ipairs(targetCollection) do
                    if not executionState.SweepAll or not humanoid or humanoid.Health <= 0 then break end
                    if myHRP and targetHRP and targetHRP.Parent then
                        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 2.5)
                        task.wait(configuration.SweepTime)
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        if executionState.ViewRandom then
            local targetHumanoid = resolveTargetEntity(500)
            if targetHumanoid then camera.CameraSubject = targetHumanoid end
        end
    end
end)
