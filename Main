local CPZMenu = loadstring(game:HttpGet("https://raw.githubusercontent.com/talaben0307-jpg/cpzmenu/refs/heads/main/menu"))()

local Window = CPZMenu:CreateWindow({
    Title = "Z hub - test",
    SubTitle = "⚡ Fixed Respawn Edition | by Phong"
})

local Tabs = {
    Main = Window:AddTab({ Title = "Main & Bypass" })
}

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer

local state = {
    Noclip = false,
    Bypass = false,
    SweepAll = false
}

local CONFIG = {
    SweepTime = 0.01
}

local resetCount = 0

-- 1. Noclip Xuyên Tường Cố Định
RunService.Stepped:Connect(function()
    if state.Noclip then
        local char = localPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- 2. Logic Bypass & Respawn Chuẩn (Dùng BreakJoints() để ép chết và hồi sinh thật)
task.spawn(function()
    while true do
        task.wait(0.5)
        if state.Bypass then
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            
            if hrp and humanoid and humanoid.Health > 0 then
                local target = nil
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        target = p.Character.HumanoidRootPart
                        break
                    end
                end
                
                if target then
                    local startPos = hrp.Position
                    hrp.CFrame = target.CFrame * CFrame.new(0, 0, 2.5)
                    
                    local teleportedBack = false
                    local timer = 0
                    
                    while timer < 2 do
                        task.wait(0.1)
                        timer = timer + 0.1
                        if not state.Bypass or not humanoid or humanoid.Health <= 0 then break end
                        if (hrp.Position - startPos).Magnitude < 8 then
                            teleportedBack = true
                            break
                        end
                    end
                    
                    if state.Bypass and humanoid and humanoid.Health > 0 then
                        if teleportedBack then
                            -- Bị kéo giật lại -> Ép bẻ khớp xương để chết và Respawn thật sự
                            while state.Bypass and localPlayer.Character do
                                pcall(function()
                                    if localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                        localPlayer.Character:BreakJoints() -- Buộc server phải công nhận nhân vật chết và cho Respawn
                                    end
                                end)
                                resetCount = resetCount + 1
                                print("[Knor bypass] BreakJoints attempts: " .. tostring(resetCount))
                                task.wait(3.5) -- Chờ thời gian để game load lại nhân vật mới
                                break
                            end
                        else
                            state.Bypass = false
                            print("[Knor bypass] Bypass Success! Total Attempts: " .. tostring(resetCount))
                            task.wait(2)
                        end
                    end
                end
            end
        end
    end
end)

-- 3. Logic Sweep All / Gojo Farm
task.spawn(function()
    while true do
        task.wait(CONFIG.SweepTime)
        if state.SweepAll then
            local myChar = localPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local humanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
            
            if myHRP and humanoid and humanoid.Health > 0 then
                local targets = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = p.Character.HumanoidRootPart
                        if (hrp.Position - myHRP.Position).Magnitude <= 500 then
                            table.insert(targets, hrp)
                        end
                    end
                end
                
                for _, targetHRP in ipairs(targets) do
                    if not state.SweepAll or not humanoid or humanoid.Health <= 0 then break end
                    if myHRP and targetHRP and targetHRP.Parent then
                        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, -3, 2.5)
                        myHRP.Velocity = Vector3.new(0, 0, 0)
                    end
                    task.wait(CONFIG.SweepTime)
                end
            end
        end
    end
end)

Tabs.Main:AddSection("Knor Bypass & Farm Controls")

Tabs.Main:AddButton({
    Title = "👻 Bật / Tắt Noclip",
    Callback = function()
        state.Noclip = not state.Noclip
        print("[Z Hub] Noclip: " .. tostring(state.Noclip))
    end
})

Tabs.Main:AddButton({
    Title = "🛡️ Bật / Tắt Bypass AC",
    Callback = function()
        state.Bypass = not state.Bypass
        if state.Bypass then
            resetCount = 0
            print("[Knor bypass] Start bypass loop...")
        else
            print("[Knor bypass] Stopped.")
        end
    end
})

Tabs.Main:AddButton({
    Title = "⚡ Bật / Tắt Gojo Sweep All",
    Callback = function()
        state.SweepAll = not state.SweepAll
        print("[Z Hub] Sweep All: " .. tostring(state.SweepAll))
    end
})

Window:SelectTab(1)
