RunService.RenderStepped:Connect(function()
    local hueValue = tick() % 5 / 5
    local dynamicRgbColor = Color3.fromHSV(hueValue, 1, 1)
    authStroke.Color = dynamicRgbColor
    submitStroke.Color = dynamicRgbColor
    mainStroke.Color = dynamicRgbColor
    floatStroke.Color = dynamicRgbColor
end)

local function authenticateUser()
    if credentialInput.Text == "0946" then
        dispatchNotification("Z Hub", "Nhập Key thành công!")
        authScreenGui:Destroy()
        mainScreenGui.Enabled = true
    else
        authPromptLabel.Text = "Sai key! Vui lòng nhập lại (0946)"
        authPromptLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end

submitButton.MouseButton1Click:Connect(authenticateUser)
credentialInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        authenticateUser()
    end
end)

local function toggleInterfaceVisibility()
    mainFrame.Visible = not mainFrame.Visible
end

floatButton.MouseButton1Click:Connect(toggleInterfaceVisibility)

UserInputService.InputBegan:Connect(function(inputObject, gameProcessed)
    if not gameProcessed and inputObject.KeyCode == Enum.KeyCode.T then
        toggleInterfaceVisibility()
    end
end)

tabMainBtn.MouseButton1Click:Connect(function()
    pageMain.Visible = true
    pageSetting.Visible = false
    tabMainBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    tabMainBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tabSettingBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    tabSettingBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
end)

