local function CreateToggleBtn(parent, yPos, text)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.BackgroundTransparency = 0.2
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.Size = UDim2.new(0, 310, 0, 45)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    return btn
end

local ToggleNoclipBtn = CreateToggleBtn(PageMain, 10, "👻 Noclip: OFF")
local ToggleBypassBtn = CreateToggleBtn(PageMain, 65, "🛡️ Bypass AC (Void Death): OFF")
local ToggleSweepBtn = CreateToggleBtn(PageMain, 120, "⚡ Gojo Sweep All: OFF")

