local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Z hub - test",
   LoadingTitle = "Z Hub Loading...",
   LoadingSubtitle = "by Phong",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "ZHubConfig",
      FileName = "ZHubSettings"
   },
   KeySystem = false,
})

local Tab = Window:CreateTab("Main & Bypass", 4483362458)

local state = {
    Noclip = false,
    Bypass = false,
    SweepAll = false
}

local CONFIG = {
    SweepTime = 0.01
}

local resetCount = 0

game:GetService("RunService").Stepped:Connect(function()
    if state.Noclip and game:GetService("Players").LocalPlayer.Character then
        for _, part in ipairs(game:GetService("Players").LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        if state.Bypass then
            local localPlayer = game:GetService("Players").LocalPlayer
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            
            if hrp and humanoid and humanoid.Health > 0 then
                local target = nil
                for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        target = p.Character.HumanoidRootPart
                        break
                    end
                end
                
                if target then
                    local startPos = hrp.Position
                    hrp.CFrame = target.CFrame * CFrame.new(0, 0, 2.5)
                    
                    local teleportedBack = false
                    local timer = 0
                    
                    while timer < 3 do
                        task.wait(0.1)
                        timer = timer + 0.1
                        if not state.Bypass or not humanoid or humanoid.Health <= 0 then break end
                        if (hrp.Position - startPos).Magnitude < 10 then
                            teleportedBack = true
                            break
                        end
                    end
                    
                    if state.Bypass and humanoid and humanoid.Health > 0 then
                        if teleportedBack then
                            local successRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Knit") 
                                and game:GetService("ReplicatedStorage").Knit:FindFirstChild("Services") 
                                and game:GetService("ReplicatedStorage").Knit.Services:FindFirstChild("JoinService")
                                and game:GetService("ReplicatedStorage").Knit.Services.JoinService:FindFirstChild("RE")
                                and game:GetService("ReplicatedStorage").Knit.Services.JoinService.RE:FindFirstChild("Reset")

                            while state.Bypass and humanoid and humanoid.Health > 0 do
                                if successRemote then
                                    successRemote:FireServer()
                                    resetCount = resetCount + 1
                                end
                                task.wait(3)
                            end
                        else
                            state.Bypass = false
                            Rayfield:Notify({
                                Title = "Knor bypass",
                                Content = "Bypass Success (Resets: " .. tostring(resetCount) .. ")",
                                Duration = 5
                            })
                            task.wait(2)
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(CONFIG.SweepTime)
        if state.SweepAll then
            local localPlayer = game:GetService("Players").LocalPlayer
            local myChar = localPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local humanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
            
            if myHRP and humanoid and humanoid.Health > 0 then
                local targets = {}
                for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = p.Character.HumanoidRootPart
                        if (hrp.Position - myHRP.Position).Magnitude <= 500 then
                            table.insert(targets, hrp)
                        end
                    end
                end
                
                for _, targetHRP in ipairs(targets) do
                    if not state.SweepAll or not humanoid or humanoid.Health <= 0 then break end
                    if myHRP and targetHRP and targetHRP.Parent then
                        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, -3, 2.5)
                        myHRP.Velocity = Vector3.new(0, 0, 0)
                    end
                    task.wait(CONFIG.SweepTime)
                end
            end
        end
    end
end)

Tab:CreateSection("Knor Bypass & Farm Controls")

Tab:CreateToggle({
   Name = "👻 Noclip (Đi xuyên tường)",
   CurrentValue = false,
   Flag = "NoclipToggle",
   Callback = function(Value)
      state.Noclip = Value
   end,
})

Tab:CreateToggle({
   Name = "🛡️ Bypass AC (Knor Auto Reset Method)",
   CurrentValue = false,
   Flag = "BypassToggle",
   Callback = function(Value)
      state.Bypass = Value
      if Value then
          resetCount = 0
          Rayfield:Notify({ Title = "Knor bypass", Content = "Start bypass...", Duration = 3 })
      end
   end,
})

Tab:CreateToggle({
   Name = "⚡ Gojo Sweep All / 0.2s Farm",
   CurrentValue = false,
   Flag = "SweepAllToggle",
   Callback = function(Value)
      state.SweepAll = Value
   end,
})

Tab:CreateInput({
   Name = "⏱️ Tốc độ Sweep (Mặc định 0.01s)",
   PlaceholderText = "0.01",
   RemoveTextAfterFocusLost = false,
   Flag = "SweepTimeInput",
   Callback = function(Text)
      local num = tonumber(Text)
      if num then
          CONFIG.SweepTime = num
      end
   end,
})

Rayfield:Notify({
   Title = "Z hub - test",
   Content = "Script đã tải thành công qua Rayfield!",
   Duration = 5
})
