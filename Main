-- ======================================================
-- Z HUB - TEST | VOID DEATH BYPASS & IN-GAME URL BACKGROUND
-- ======================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local localPlayer = Players.LocalPlayer

local state = {
    Noclip = false,
    Bypass = false,
    SweepAll = false
}
local CONFIG = { SweepTime = 0.01 }
local resetCount = 0

-- 1. TẠO MENU GIAO DIỆN TÙY CHỈNH
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local UICorner = Instance.new("UICorner")
local BgImage = Instance.new("ImageLabel")
local TitleLabel = Instance.new("TextLabel")
local ToggleNoclipBtn = Instance.new("TextButton")
local ToggleBypassBtn = Instance.new("TextButton")
local ToggleSweepBtn = Instance.new("TextButton")
local UrlInput = Instance.new("TextBox")
local ApplyBgBtn = Instance.new("TextButton")

ScreenGui.Name = "ZHubTest"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.Position = UDim2.new(0.5, -125, 0.3, 0)
MainFrame.Size = UDim2.new(0, 250, 0, 290) -- Tăng chiều cao để chứa ô nhập URL
MainFrame.Active = true
MainFrame.Draggable = true
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainFrame

-- Lớp ảnh nền
BgImage.Parent = MainFrame
BgImage.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
BgImage.BackgroundTransparency = 1
BgImage.Size = UDim2.new(1, 0, 1, 0)
-- Mặc định để trống hoặc tải 1 ảnh mặc định nếu muốn
BgImage.ScaleType = Enum.ScaleType.Crop
BgImage.ImageTransparency = 0.4
local BgCorner = Instance.new("UICorner")
BgCorner.CornerRadius = UDim.new(0, 10)
BgCorner.Parent = BgImage

TitleLabel.Parent = MainFrame
TitleLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
TitleLabel.BackgroundTransparency = 0.5
TitleLabel.Size = UDim2.new(1, 0, 0, 45)
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.Text = "Z hub - test"
TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TitleLabel.TextSize = 20
local TitleCorner = Instance.new("UICorner")
TitleCorner.CornerRadius = UDim.new(0, 10)
TitleCorner.Parent = TitleLabel

local function CreateBtnStyle(btn, yPos, text, sizeX)
    btn.Parent = MainFrame
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.BackgroundTransparency = 0.2
    btn.Position = UDim2.new(0, 15, 0, yPos)
    btn.Size = UDim2.new(0, sizeX or 220, 0, 40)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
end

CreateBtnStyle(ToggleNoclipBtn, 60, "👻 Noclip: OFF")
CreateBtnStyle(ToggleBypassBtn, 115, "🛡️ Bypass AC: OFF")
CreateBtnStyle(ToggleSweepBtn, 170, "⚡ Gojo Sweep All: OFF")

-- Ô nhập URL và Nút Đổi Ảnh
UrlInput.Parent = MainFrame
UrlInput.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
UrlInput.Position = UDim2.new(0, 15, 0, 230)
UrlInput.Size = UDim2.new(0, 160, 0, 40)
UrlInput.Font = Enum.Font.Gotham
UrlInput.PlaceholderText = "Dán link ảnh (URL)..."
UrlInput.Text = ""
UrlInput.TextColor3 = Color3.fromRGB(255, 255, 255)
UrlInput.TextSize = 12
UrlInput.TextXAlignment = Enum.TextXAlignment.Left
UrlInput.ClearTextOnFocus = false
UrlInput.ClipsDescendants = true
local InputCorner = Instance.new("UICorner")
InputCorner.CornerRadius = UDim.new(0, 6)
InputCorner.Parent = UrlInput

CreateBtnStyle(ApplyBgBtn, 230, "Đổi", 50)
ApplyBgBtn.Position = UDim2.new(0, 185, 0, 230)
ApplyBgBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 200)

-- Xử lý nút bấm
ToggleNoclipBtn.MouseButton1Click:Connect(function()
    state.Noclip = not state.Noclip
    ToggleNoclipBtn.Text = state.Noclip and "👻 Noclip: ON" or "👻 Noclip: OFF"
    ToggleNoclipBtn.BackgroundColor3 = state.Noclip and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
end)

ToggleBypassBtn.MouseButton1Click:Connect(function()
    state.Bypass = not state.Bypass
    ToggleBypassBtn.Text = state.Bypass and "🛡️ Bypass AC: ON" or "🛡️ Bypass AC: OFF"
    ToggleBypassBtn.BackgroundColor3 = state.Bypass and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
    if state.Bypass then resetCount = 0 end
end)

ToggleSweepBtn.MouseButton1Click:Connect(function()
    state.SweepAll = not state.SweepAll
    ToggleSweepBtn.Text = state.SweepAll and "⚡ Gojo Sweep All: ON" or "⚡ Gojo Sweep All: OFF"
    ToggleSweepBtn.BackgroundColor3 = state.SweepAll and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
end)

ApplyBgBtn.MouseButton1Click:Connect(function()
    local url = UrlInput.Text
    if url and url ~= "" then
        ApplyBgBtn.Text = "..."
        pcall(function()
            local imgData = game:HttpGet(url)
            writefile("ZHub_CustomBg.png", imgData)
            BgImage.Image = getcustomasset("ZHub_CustomBg.png")
        end)
        ApplyBgBtn.Text = "Đổi"
    end
end)

-- 2. LOGIC SCRIPT CHÍNH
RunService.Stepped:Connect(function()
    if state.Noclip and localPlayer.Character then
        for _, part in ipairs(localPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        if state.Bypass then
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            
            if hrp and humanoid and humanoid.Health > 0 then
                local target = nil
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        target = p.Character.HumanoidRootPart
                        break
                    end
                end
                
                if target then
                    local startPos = hrp.Position
                    hrp.CFrame = target.CFrame * CFrame.new(0, 0, 2.5)
                    
                    local teleportedBack = false
                    local timer = 0
                    
                    while timer < 3 do
                        task.wait(0.1)
                        timer = timer + 0.1
                        if not state.Bypass or not humanoid or humanoid.Health <= 0 then break end
                        if (hrp.Position - startPos).Magnitude < 10 then
                            teleportedBack = true
                            break
                        end
                    end
                    
                    if state.Bypass and humanoid and humanoid.Health > 0 then
                        if teleportedBack then
                            -- ÉP CHẾT BẰNG VOID DEATH (Dịch chuyển xuống vực sâu -99999)
                            while state.Bypass and localPlayer.Character do
                                pcall(function()
                                    local char = localPlayer.Character
                                    local root = char:FindFirstChild("HumanoidRootPart")
                                    local hum = char:FindFirstChild("Humanoid")
                                    
                                    if hum then hum:ChangeState(Enum.HumanoidStateType.Dead) end
                                    
                                    if root then
                                        root.CFrame = CFrame.new(0, -99999, 0)
                                    end
                                end)
                                resetCount = resetCount + 1
                                print("[Knor Bypass] Void Death attempts: " .. tostring(resetCount))
                                task.wait(3.5)
                                break
                            end
                        else
                            state.Bypass = false
                            ToggleBypassBtn.Text = "🛡️ Bypass AC: OFF"
                            ToggleBypassBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                            print("[Knor Bypass] Success!")
                            task.wait(2)
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(CONFIG.SweepTime)
        if state.SweepAll then
            local myChar = localPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local humanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
            
            if myHRP and humanoid and humanoid.Health > 0 then
                local targets = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = p.Character.HumanoidRootPart
                        if (hrp.Position - myHRP.Position).Magnitude <= 500 then
                            table.insert(targets, hrp)
                        end
                    end
                end
                
                for _, targetHRP in ipairs(targets) do
                    if not state.SweepAll or not humanoid or humanoid.Health <= 0 then break end
                    if myHRP and targetHRP and targetHRP.Parent then
                        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, -3, 2.5)
                        myHRP.Velocity = Vector3.new(0, 0, 0)
                    end
                    task.wait(CONFIG.SweepTime)
                end
            end
        end
    end
end)
