local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local localPlayer = Players.LocalPlayer

local state = {
    Noclip = false,
    Bypass = false,
    SweepAll = false
}

local CONFIG = {
    SweepTime = 0.01
}

local resetCount = 0

-- Tạo Menu UI Đơn Giản, Chống Crash Tuyệt Đối
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local TitleLabel = Instance.new("TextLabel")
local ToggleNoclipBtn = Instance.new("TextButton")
local ToggleBypassBtn = Instance.new("TextButton")
local ToggleSweepBtn = Instance.new("TextButton")

ScreenGui.Name = "ZHubTest"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.Position = UDim2.new(0.1, 0, 0.1, 0)
MainFrame.Size = UDim2.new(0, 240, 0, 220)
MainFrame.Active = true
MainFrame.Draggable = true

TitleLabel.Parent = MainFrame
TitleLabel.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
TitleLabel.Size = UDim2.new(0, 240, 0, 40)
TitleLabel.Font = Enum.Font.SourceSansBold
TitleLabel.Text = "Z hub - test"
TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TitleLabel.TextSize = 18

ToggleNoclipBtn.Parent = MainFrame
ToggleNoclipBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
ToggleNoclipBtn.Position = UDim2.new(0, 10, 0, 55)
ToggleNoclipBtn.Size = UDim2.new(0, 220, 0, 40)
ToggleNoclipBtn.Font = Enum.Font.SourceSansBold
ToggleNoclipBtn.Text = "Noclip: OFF"
ToggleNoclipBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleNoclipBtn.TextSize = 14

ToggleBypassBtn.Parent = MainFrame
ToggleBypassBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
ToggleBypassBtn.Position = UDim2.new(0, 10, 0, 105)
ToggleBypassBtn.Size = UDim2.new(0, 220, 0, 40)
ToggleBypassBtn.Font = Enum.Font.SourceSansBold
ToggleBypassBtn.Text = "Bypass AC: OFF"
ToggleBypassBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBypassBtn.TextSize = 14

ToggleSweepBtn.Parent = MainFrame
ToggleSweepBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
ToggleSweepBtn.Position = UDim2.new(0, 10, 0, 155)
ToggleSweepBtn.Size = UDim2.new(0, 220, 0, 40)
ToggleSweepBtn.Font = Enum.Font.SourceSansBold
ToggleSweepBtn.Text = "Gojo Sweep All: OFF"
ToggleSweepBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleSweepBtn.TextSize = 14

-- Xử lý sự kiện bấm nút
ToggleNoclipBtn.MouseButton1Click:Connect(function()
    state.Noclip = not state.Noclip
    ToggleNoclipBtn.Text = state.Noclip and "Noclip: ON" or "Noclip: OFF"
    ToggleNoclipBtn.BackgroundColor3 = state.Noclip and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(60, 60, 60)
end)

ToggleBypassBtn.MouseButton1Click:Connect(function()
    state.Bypass = not state.Bypass
    ToggleBypassBtn.Text = state.Bypass and "Bypass AC: ON" or "Bypass AC: OFF"
    ToggleBypassBtn.BackgroundColor3 = state.Bypass and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(60, 60, 60)
    if state.Bypass then resetCount = 0 end
end)

ToggleSweepBtn.MouseButton1Click:Connect(function()
    state.SweepAll = not state.SweepAll
    ToggleSweepBtn.Text = state.SweepAll and "Gojo Sweep All: ON" or "Gojo Sweep All: OFF"
    ToggleSweepBtn.BackgroundColor3 = state.SweepAll and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(60, 60, 60)
end)

-- 1. Noclip Xuyên Tường
RunService.Stepped:Connect(function()
    if state.Noclip then
        local char = localPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- 2. Knor Bypass & Force Death Loop
task.spawn(function()
    while true do
        task.wait(0.5)
        if state.Bypass then
            local character = localPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            
            if hrp and humanoid and humanoid.Health > 0 then
                local target = nil
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        target = p.Character.HumanoidRootPart
                        break
                    end
                end
                
                if target then
                    local startPos = hrp.Position
                    hrp.CFrame = target.CFrame * CFrame.new(0, 0, 2.5)
                    
                    local teleportedBack = false
                    local timer = 0
                    
                    while timer < 3 do
                        task.wait(0.1)
                        timer = timer + 0.1
                        if not state.Bypass or not humanoid or humanoid.Health <= 0 then break end
                        if (hrp.Position - startPos).Magnitude < 10 then
                            teleportedBack = true
                            break
                        end
                    end
                    
                    if state.Bypass and humanoid and humanoid.Health > 0 then
                        if teleportedBack then
                            local resetRemote = ReplicatedStorage:FindFirstChild("Knit") 
                                and ReplicatedStorage.Knit:FindFirstChild("Services") 
                                and ReplicatedStorage.Knit.Services:FindFirstChild("JoinService")
                                and ReplicatedStorage.Knit.Services.JoinService:FindFirstChild("RE")
                                and ReplicatedStorage.Knit.Services.JoinService.RE:FindFirstChild("Reset")

                            while state.Bypass and localPlayer.Character do
                                pcall(function()
                                    if resetRemote then
                                        resetRemote:FireServer()
                                    end
                                    local char = localPlayer.Character
                                    if char then
                                        local rootPart = char:FindFirstChild("HumanoidRootPart")
                                        if rootPart then
                                            rootPart:Destroy()
                                        end
                                    end
                                end)
                                resetCount = resetCount + 1
                                print("[Knor bypass] Force Death attempts: " .. tostring(resetCount))
                                task.wait(3)
                                break
                            end
                        else
                            state.Bypass = false
                            ToggleBypassBtn.Text = "Bypass AC: OFF"
                            ToggleBypassBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                            print("[Knor bypass] Success!")
                            task.wait(2)
                        end
                    end
                end
            end
        end
    end
end)

-- 3. Logic Sweep All / Gojo Farm
task.spawn(function()
    while true do
        task.wait(CONFIG.SweepTime)
        if state.SweepAll then
            local myChar = localPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local humanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
            
            if myHRP and humanoid and humanoid.Health > 0 then
                local targets = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = p.Character.HumanoidRootPart
                        if (hrp.Position - myHRP.Position).Magnitude <= 500 then
                            table.insert(targets, hrp)
                        end
                    end
                end
                
                for _, targetHRP in ipairs(targets) do
                    if not state.SweepAll or not humanoid or humanoid.Health <= 0 then break end
                    if myHRP and targetHRP and targetHRP.Parent then
                        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, -3, 2.5)
                        myHRP.Velocity = Vector3.new(0, 0, 0)
                    end
                    task.wait(CONFIG.SweepTime)
                end
            end
        end
    end
end)
